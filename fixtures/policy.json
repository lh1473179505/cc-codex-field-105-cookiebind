      "digest_algorithms": {
        "sha256": 64
      },
      "request_nonce_prefix": "pay-",
      "cert_req_values": [
        true
      ],
      "policy_oids": [
        "1.2.3.4.1"
      ]
    },
    "https://tsa.ops.example": {
      "digest_algorithms": {
        "sha384": 96
      },
      "request_nonce_prefix": "ops-",
