{
  "supply_chains": {
    "pay-release": {
      "steps": {
        "build": {
          "pubkeys_allowed": [
            "key-pay-1",
            "key-pay-2",
            "key-pay-3"
          ],
          "pubkeys_required": [
            "key-pay-1"
          ],
          "threshold_min": 2,
          "threshold_max": 3,
          "artifact_verbs": [
            "MATCH",
            "CREATE"
          ],
          "artifact_path_prefixes": [
            "src/app/",
            "products/"
          ],
          "artifact_rules_required": [
            "CREATE products/app.tar.gz"
          ]
        },
        "sign": {
          "pubkeys_allowed": [
            "key-pay-sign"
          ],
          "pubkeys_required": [
            "key-pay-sign"
          ],
          "threshold_min": 1,
          "threshold_max": 1,
          "artifact_verbs": [
            "ALLOW"
          ],
          "artifact_path_prefixes": [
            "products/"
          ],
          "artifact_rules_required": [
            "ALLOW products/app.tar.gz"
          ]
        }
      }
    },
    "ops-release": {
      "steps": {
        "sign": {
          "pubkeys_allowed": [
            "key-ops-1"
          ],
          "pubkeys_required": [
            "key-ops-1"
          ],
          "threshold_min": 1,
          "threshold_max": 1,
          "artifact_verbs": [
            "ALLOW"
          ],
          "artifact_path_prefixes": [
            "products/"
          ],
          "artifact_rules_required": [
            "ALLOW products/ops.txt"
          ]
        }
      }
    }
  },
  "require_unique_pubkeys": true,
  "artifact_path_deny_substrings": [
    "..",
    "\\",
    "//",
    "\u0000"
  ],
  "artifact_rule_max": 3,
  "layout_sha256_hex_len": 64,
  "require_lowercase_hex": true,
  "clock_skew_seconds": 60,
  "max_age_seconds": 600
}
