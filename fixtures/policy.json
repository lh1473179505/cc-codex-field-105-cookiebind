{
  "overlays": {
    "pay-prod": {
      "base_path": "bases/pay",
      "resources": [
        "bases/pay",
        "resources/pay-service.yaml",
        "resources/pay-hpa.yaml"
      ],
      "patches": [
        "patches/pay-replicas.yaml",
        "patches/pay-resources.yaml"
      ],
      "namespace": "pay-prod",
      "secret_fields": []
    },
    "ops-staging": {
      "base_path": "bases/ops",
      "resources": [
        "bases/ops",
        "resources/ops-service.yaml"
      ],
      "patches": [
        "patches/ops-staging.yaml"
      ],
      "namespace": "ops-staging",
      "secret_fields": []
    }
  },
  "forbidden_secret_fields": [
    "secretGenerator",
    "generators",
    "literals",
    "files",
    "envs"
  ],
  "path_deny_substrings": [
    "..",
    "//",
    "\\",
    "\u0000"
  ],
  "require_unique_lists": true,
  "clock_skew_seconds": 60,
  "max_age_seconds": 600
}
