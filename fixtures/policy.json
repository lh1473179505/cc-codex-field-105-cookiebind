{
  "builds": {
    "pay-web-2026.06": {
      "targets": {
        "release": {
          "secrets": {
            "pay_npm_token": {
              "mount_path": "/run/secrets/pay_npm_token",
              "mode": 256,
              "uid": 1000,
              "gid": 1000,
              "required": true,
              "cache_sharing": "locked",
              "cache_key": "pay-release-npm-v3"
            }
          }
        }
      }
    },
    "ops-agent-2026.07": {
      "targets": {
        "runtime": {
          "secrets": {
            "ops_signing_key": {
              "mount_path": "/run/secrets/ops_signing_key",
              "mode": 384,
              "uid": 0,
              "gid": 0,
              "required": true,
              "cache_sharing": "private",
              "cache_key": "ops-runtime-signing-v2"
            }
          }
        }
      }
    }
  },
  "mount_root": "/run/secrets/",
  "mode_is_octal_integer": true,
  "path_deny_substrings": [
    "..",
    "//",
    "\\",
    "\u0000"
  ],
  "clock_skew_seconds": 60,
  "max_age_seconds": 600
}
