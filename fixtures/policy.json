        false,
        true
      ],
      "policy_oids": [
        "1.2.3.4.2"
      ]
    }
  },
  "request_nonce_pattern": "^[a-z]+-[A-Za-z0-9]{16,32}$",
  "require_lowercase_imprint": true
}
