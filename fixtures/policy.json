                  "eu",
                  "us"
                ]
              }
            },
            "sqs": {
              "endpoints": [
                "arn:aws:sqs:us-east-1:111122223333:pay-delivery"
              ],
              "raw_message_delivery": true,
              "filter_policy": {
                "event": [
                  "order.created",
                  "order.paid"
                ]
              }
            }
          }
        }
      }
    },
    "arn:aws:sns:us-west-2:444455556666:ops-events": {
      "principals": {
        "arn:aws:iam::444455556666:role/ops-delivery": {
          "subscriptions": {
            "https": {
              "endpoints": [
                "https://ops-hooks.example/sns"
              ],
